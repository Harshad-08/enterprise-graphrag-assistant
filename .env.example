# Copy to .env and adjust. Never commit real credentials.

# --- LLM ----------------------------------------------------------------------
# auto   = Gemini if GEMINI_API_KEY is set, else Groq if GROQ_API_KEY is set, else the labelled mock
# groq | gemini = that provider only (startup fails without its key) | mock = deterministic extractive mock
LLM_PROVIDER=auto

# Groq (official groq SDK). Use a model your key can access (see console.groq.com).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# gpt-oss reasoning effort (low|medium|high); reasoning tokens count towards rate limits
GROQ_REASONING_EFFORT=low

# Google Gemini (google-genai SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=60
# Retries with backoff (honours Retry-After on HTTP 429 rate limits)
LLM_MAX_RETRIES=8
# rule (default, deterministic) | llm (Gemini adds claims; each must appear verbatim in its chunk)
EXTRACTION_BACKEND=rule

# --- Neo4j -------------------------------------------------------------------
# neo4j (default) | memory (in-process store for offline demos/tests; not persistent)
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# --- Embeddings, reranking, verification -------------------------------------
# sentence-transformers (default) | hashing (deterministic, lexical-only, offline)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# nli (local NLI cross-encoder) | llm (Gemini judge) | lexical (heuristic fallback)
VERIFIER_BACKEND=nli
NLI_MODEL=cross-encoder/nli-deberta-v3-xsmall

# --- Chunking & retrieval ----------------------------------------------------
CHUNK_MAX_CHARS=700
CHUNK_OVERLAP_SENTENCES=1
VECTOR_TOP_K=20
KEYWORD_TOP_K=20
RRF_K=60
RERANK_CANDIDATES=20
FINAL_TOP_K=6
INCLUDE_SUPERSEDED_IN_RETRIEVAL=true

# --- Evidence sufficiency (leave empty to use data/evaluation/calibration.json) -
SUFFICIENCY_THRESHOLD=
MIN_CHUNK_RELEVANCE=
MIN_CONCEPT_COVERAGE=
STRONG_RELEVANCE=

# --- Recovery ------------------------------------------------------------------
RECOVERY_ENABLED=true
RECOVERY_MAX_ATTEMPTS=2
GRAPH_MAX_HOPS=2
GRAPH_MAX_CHUNKS=30

# --- Reliability -----------------------------------------------------------------
CONTRADICTION_SIMILARITY_THRESHOLD=0.75
NLI_CONTRADICTION_THRESHOLD=0.7
NLI_ENTAILMENT_THRESHOLD=0.5
LEXICAL_SUPPORT_THRESHOLD=0.6
MAX_CORRECTION_ATTEMPTS=1
# Re-attributing a claim to a passage the LLM did not cite needs this support score
CITATION_REPAIR_THRESHOLD=0.8
CONFLICT_PRECEDENCE=supersession,status,authority,effective_date,version
AUTHORITY_LEVELS=board:5,executive:4,department:3,team:2,individual:1

# --- Upload / app ------------------------------------------------------------------
MAX_UPLOAD_MB=10
SEED_ON_STARTUP=false
LOG_LEVEL=INFO

# --- Evaluation ----------------------------------------------------------------------
RAGAS_ENABLED=true
# Ragas judge. On Groq the default spreads metrics over models (context_precision ->
# openai/gpt-oss-20b, others -> openai/gpt-oss-120b) because rate limits are per model.
# RAGAS_JUDGE_MODEL forces one model for all metrics; RAGAS_JUDGE_MODELS=metric:model,... overrides per metric.
RAGAS_JUDGE_MODEL=
RAGAS_JUDGE_MODELS=
# Reasoning judges truncate at ragas' default (1024). Must not exceed the model's output-tokens-per-minute
# limit (qwen/qwen3.8-27b on the free tier: 1000).
RAGAS_MAX_TOKENS=4096

# --- Frontend --------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000

# Host port for the API container in docker compose (default 8000)
API_PORT=8000
